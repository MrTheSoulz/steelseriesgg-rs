#!/bin/sh
set -eu
case "$1" in
  remove|purge)
    if command -v apparmor_parser >/dev/null 2>&1 && [ -d /sys/kernel/security/apparmor ] && [ -f /etc/apparmor.d/io.github.MrTheSoulz.SSGG ]; then
      apparmor_parser -R /etc/apparmor.d/io.github.MrTheSoulz.SSGG || true
    fi
    if command -v udevadm >/dev/null 2>&1 && [ -S /run/udev/control ]; then
      udevadm control --reload-rules
    fi
    ;;
esac
if command -v update-desktop-database >/dev/null 2>&1; then
  update-desktop-database -q /usr/share/applications
fi
if command -v gtk-update-icon-cache >/dev/null 2>&1; then
  gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor
fi
# User state and all existing ssgg/ssgg-desktop services belong to the user.
