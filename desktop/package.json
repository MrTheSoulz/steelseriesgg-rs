{
  "name": "ssgg-desktop",
  "version": "0.1.1",
  "private": true,
  "productName": "SSGG",
  "desktopName": "io.github.MrTheSoulz.SSGG.desktop",
  "type": "module",
  "main": "dist-main/main.cjs",
  "scripts": {
    "build": "vite build && node scripts/build-main.mjs",
    "test": "NODE_ENV=test vitest run",
    "typecheck": "tsc --noEmit",
    "start": "npm run build && electron .",
    "build:local": "node scripts/build-local.mjs",
    "launch": "node scripts/launch.mjs",
    "package:app": "node scripts/package-linux.mjs",
    "package:deb": "node scripts/package-linux.mjs --deb",
    "test:packaging": "node --test tests/packaging.test.mjs",
    "smoke:packaged": "node scripts/test-session.mjs node tests/packaged-smoke.mjs",
    "smoke": "npm run build && node scripts/test-session.mjs node tests/smoke.mjs && node scripts/test-session.mjs node tests/service-smoke.mjs && node scripts/test-session.mjs node tests/wheel-setup-smoke.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "electron": "44.2.0",
    "esbuild": "^0.25.0",
    "jsdom": "^26.0.0",
    "playwright": "^1.51.0",
    "prettier": "^3.9.6",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^3.1.0"
  }
}
