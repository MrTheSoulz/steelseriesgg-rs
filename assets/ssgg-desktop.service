# Optional user service TEMPLATE. Not installed or enabled by the desktop.
# Copy the trusted binary to ~/.local/bin/ssgg-desktop before using this unit.
# Requires pactl (pulseaudio-utils on Debian/Ubuntu; libpulse on Arch),
# and a running PipeWire-Pulse or PulseAudio user session.
[Unit]
Description=SSGG private desktop audio and opt-in headset service
After=pipewire-pulse.service

[Service]
Type=simple
ExecStart=%h/.local/bin/ssgg-desktop
Restart=on-failure
RestartSec=3
UMask=0077
RuntimeDirectory=ssgg-desktop
RuntimeDirectoryMode=0700
NoNewPrivileges=yes

[Install]
WantedBy=default.target
